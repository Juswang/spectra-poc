// Database schema: User, Account, Session, Role, Agency, UserAgency, ServiceAgencyMapping, ServiceStatus, AdoptionMetric.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Required Models ───────────────────────────

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  agencies      UserAgency[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ─────────────────────────────────

model Role {
  id           String       @id @default(cuid())
  name         String       @unique
  description  String?
  userAgencies UserAgency[]
  createdAt    DateTime     @default(now())
}

model Agency {
  id              String               @id @default(cuid())
  name            String               @unique
  code            String               @unique
  users           UserAgency[]
  serviceMappings ServiceAgencyMapping[]
  adoptionMetrics AdoptionMetric[]
  createdAt       DateTime             @default(now())
}

model UserAgency {
  id       String @id @default(cuid())
  userId   String
  agencyId String
  roleId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, agencyId])
}

model ServiceAgencyMapping {
  id          String @id @default(cuid())
  serviceName String
  agencyCode  String
  agency      Agency @relation(fields: [agencyCode], references: [code])

  @@unique([serviceName, agencyCode])
}

model ServiceStatus {
  id             String   @id @default(cuid())
  serviceName    String
  url            String
  httpStatusCode Int
  responseTimeMs Int
  isUp           Boolean
  checkedAt      DateTime @default(now())

  @@index([serviceName, checkedAt])
}

model AdoptionMetric {
  id          String   @id @default(cuid())
  agencyCode  String
  agency      Agency   @relation(fields: [agencyCode], references: [code])
  month       String
  product     String
  provisioned Int
  active      Int
  daily       Int
  emails      Int      @default(0)
  spam        Int      @default(0)
  sessions    Int
  duration    Float    @default(0)
  hosts       Int      @default(0)
  minutes     Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([agencyCode, month, product])
  @@index([month])
  @@index([agencyCode])
}
