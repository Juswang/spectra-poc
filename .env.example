# ==================================================
# Spectra POC — Environment Variables Template
# ==================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ==================================================

# --- Microsoft Entra ID (Authentication) ---
# Get these from: entra.microsoft.com → App registrations → Spectra POC
AZURE_AD_CLIENT_ID=your-client-id-here
AZURE_AD_CLIENT_SECRET=your-client-secret-here
AZURE_AD_TENANT_ID=your-tenant-id-here

# --- NextAuth.js ---
# NEXTAUTH_URL: The URL where your app runs
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-string-here

# --- Databricks ---
# Get these from your Databricks workspace
DATABRICKS_HOST=https://adb-1234567890.12.azuredatabricks.net
DATABRICKS_TOKEN=your-personal-access-token-here
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id-here
